{
  "name": "claude-reels-studio",
  "version": "0.1.0",
  "private": true,
  "description": "Remotion project for the Claude Reels brand — one composition per Reel.",
  "scripts": {
    "dev": "remotion studio src/index.ts",
    "typecheck": "tsc --noEmit",
    "render:reel-001-animatic": "remotion render src/index.ts Reel001Animatic out/reel-001-animatic.mp4",
    "still:reel-001": "remotion still src/index.ts Reel001Animatic out/reel-001-frame0.png --frame=0"
  },
  "dependencies": {
    "@remotion/cli": "4.0.538",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "remotion": "4.0.538"
  },
  "devDependencies": {
    "@types/react": "18.3.12",
    "typescript": "5.6.3"
  }
}
